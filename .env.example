# LlamaTrade Environment Variables

# Alpaca API (Paper Trading)
ALPACA_API_KEY=your_paper_api_key
ALPACA_API_SECRET=your_paper_api_secret

# Alpaca OAuth ("Connect with Alpaca") — register an app in Alpaca's dashboard.
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
# Public callback URL on the AUTH service (must match the registered redirect URI).
ALPACA_OAUTH_REDIRECT_URI=http://localhost:8810/oauth/alpaca/callback
ALPACA_OAUTH_SCOPE=trading
# Where auth redirects the browser back to after an OAuth link.
WEB_APP_URL=http://localhost:8800

# JWT Secret — signs internal service tokens, and user tokens in dev/test only
# (generate a strong random string for production)
JWT_SECRET=dev-secret-change-in-production

# Asymmetric user-token signing (G17) — RS256 PEM keypair, REQUIRED in
# production/staging (the auth service fails closed at startup without it).
# Generate:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Private key: auth service ONLY. Public key: every service (verification).
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=

# Encryption Key (generate a strong random string for production)
ENCRYPTION_KEY=dev-encryption-key-change-me

# Credential envelope cipher: local (PBKDF2+Fernet) | gcp-kms (Cloud KMS wraps a
# per-credential data key; needs the llamatrade-common[gcp-kms] extra)
CREDENTIAL_CIPHER=local
# Cloud KMS key for CREDENTIAL_CIPHER=gcp-kms — either the full resource name or
# the four components (project and location default to GCP_PROJECT_ID/GCP_REGION).
# KMS_KEY_NAME=projects/<project>/locations/<location>/keyRings/<ring>/cryptoKeys/<key>
# KMS_PROJECT_ID=
# KMS_LOCATION=
# KMS_KEY_RING=
# KMS_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llamatrade

# Redis
REDIS_URL=redis://localhost:6379

# ===================
# Event Backbone (Kafka / GCP Managed Service for Apache Kafka)
# ===================
# Local dev broker is the Redpanda container (advertised on localhost:9092); in
# GCP this is the Managed Kafka bootstrap address.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# PLAINTEXT locally; SASL_SSL (OAUTHBEARER via Workload Identity) in GCP.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Topic auto-creation is a dev convenience only (defaults on for PLAINTEXT);
# non-dev environments provision topics through Terraform and fail loudly.
# KAFKA_AUTO_CREATE_TOPICS=true
# Budget for a client to connect, authenticate and complete one metadata
# round-trip. A rejected OAUTHBEARER token authenticates without an error on the
# wire, so the start is bounded and then proven live; past this the client is
# abandoned and counted on llamatrade_events_client_start_failures_total.
# KAFKA_CLIENT_START_TIMEOUT_SECONDS=30
# Consecutive failures to start a reader before the run is reported as broken
# credentials (llamatrade_events_broken_credentials_total) rather than a
# transient fault. Readers keep retrying either way; this only changes the signal.
# KAFKA_AUTH_FAILURE_ALERT_THRESHOLD=5

# OpenTelemetry traces (optional): OTLP/HTTP export target. The Docker dev stack
# sets this per service; for `make dev-local` point at the local collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Stripe (optional - for billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public SPA origin used in emailed links (password reset, verification)
APP_BASE_URL=http://localhost:8800

# SMTP (optional - for email notifications)
# Base URL the notification service builds email asset links from (e.g. the header logo).
EMAIL_ASSET_BASE_URL=https://app.llamatrade.ai

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@llamatrade.com

# Agent / LLM (AI copilot service - required for agent to make LLM calls)
# The copilot defaults to Google Gemini; set GOOGLE_API_KEY for the default path.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
# Provider selection (default: google). Alternatives: anthropic.
# AGENT_LLM_PROVIDER=google
# AGENT_LLM_MODEL=gemini-2.5-flash
# AGENT_LLM_FAST_MODEL=gemini-2.5-flash-lite   # extraction + summaries

# GCP (for deployment)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# ===================
# gRPC Configuration
# ===================
# Enable/disable gRPC for all services (set to false to use HTTP only)
USE_GRPC=true

# Enable gRPC for specific inter-service calls
USE_GRPC_MARKET_DATA=true

# gRPC service targets (for inter-service communication)
MARKET_DATA_GRPC_TARGET=market-data:8840
AUTH_GRPC_TARGET=auth:8810
TRADING_GRPC_TARGET=trading:8850
BACKTEST_GRPC_TARGET=backtest:8830

# ===================
# Portfolio Ledger (the book of record — always on; no feature flags)
# ===================
# Reconciliation cadence: how often the ledger aggregate is checked against
# broker truth (seconds).
LEDGER_RECONCILE_INTERVAL_SECONDS=300
# Equity-curve snapshot cadence: how often accounts/sleeves are marked to market
# into the read-side time series (seconds).
LEDGER_SNAPSHOT_INTERVAL_SECONDS=3600

# ===================
# Trading (live execution)
# ===================
# Order-intent capture: a directory where each live session appends one JSON line
# per evaluation (the sized intents and the client order ids they would submit
# under), used to diff the two live loops in a parity soak. Empty or unset means
# nothing is constructed and no work is done per evaluation.
# TRADING_INTENT_CAPTURE_DIR=/var/lib/llamatrade/intent-capture

# === Market-Data Store (dedicated TimescaleDB) ===
# The market-data service ingests Alpaca bars into a dedicated Timescale instance
# and serves the platform from it (Alpaca is fallback only).
MARKET_DATA_DB_URL=postgresql+asyncpg://postgres:postgres@timescaledb:5432/market_data
MARKET_DATA_FEED=iex                      # iex (free) or sip (paid, full universe)
MARKET_DATA_UNIVERSE=AAPL,MSFT,SPY        # comma-separated symbols to sync
MARKET_DATA_MINUTE_LOOKBACK_DAYS=5        # recent minute-bar window to backfill
MARKET_DATA_DAILY_LOOKBACK_DAYS=365       # daily history to backfill
MARKET_DATA_BARS_FROM_BUS=true            # serving sources live bars from the bus
