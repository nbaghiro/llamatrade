# Dev image for the web app. Build context is the repo root (see docker-compose.dev.yml) for a single workspace-aware install.
FROM node:20-alpine

WORKDIR /app

# apps/web depends on @llamatrade/core, so its manifest must be present for the workspace install.
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/core/package.json ./apps/core/package.json

# Workspace-aware install: links workspaces and hoists shared deps to /app/node_modules.
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

WORKDIR /app/apps/web

# Internal port only; the Caddy proxy on :8800 fronts this app (see infrastructure/docker/Caddyfile).
EXPOSE 8802

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "8802"]
