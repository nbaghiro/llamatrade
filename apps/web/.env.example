# Frontend Environment Variables

# Direct service URLs for Connect protocol (no proxy needed)
VITE_AUTH_URL=http://localhost:8810
VITE_STRATEGY_URL=http://localhost:8820
VITE_BACKTEST_URL=http://localhost:8830
VITE_MARKET_DATA_URL=http://localhost:8840
VITE_TRADING_URL=http://localhost:8850
VITE_PORTFOLIO_URL=http://localhost:8860
VITE_NOTIFICATION_URL=http://localhost:8870
VITE_BILLING_URL=http://localhost:8880
# Agent (AI copilot). Docker dev remaps its host port to 8990 to avoid a local
# service on 8890; override here if running the agent elsewhere.
VITE_AGENT_URL=http://localhost:8990

# WebSocket URL for real-time updates (still via gateway for now)
VITE_WS_URL=ws://localhost:8840/ws

# Stripe publishable key (required for billing)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Frontend runs on port 8800 (configurable via vite.config.ts)

# Marketing invite form: posts to JoinWaitlist on VITE_AUTH_URL. Inside the app it falls back to
# http://localhost:8810 like the other clients; the standalone marketing build
# (npm run build:marketing) needs VITE_AUTH_URL set, and its origin listed in the auth
# service's CORS_ORIGINS, or the form stays closed.
# Standalone marketing build only: with no VITE_AUTH_URL, the invite forms become an email link to
# this address (defaults to hello@llamatrade.ai).
# VITE_INVITE_EMAIL=
# Waitlist in Loops: the form ID from app.loops.so/forms > Settings > Form Endpoint (the last part
# of the URL). Defaults to the LlamaTrade form; the invite forms subscribe there, ahead of the two options above.
# VITE_LOOPS_FORM_ID=
